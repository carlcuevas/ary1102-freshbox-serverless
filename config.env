# Configuracion central (sin secretos). Los IDs creados se guardan en state.env
REGION=us-east-1
PROJECT=freshbox
VPC_CIDR=10.0.0.0/22
CLUSTER_NAME=freshbox-cluster
K8S_VERSION=1.34
NODEGROUP=freshbox-ng
NODE_TYPE=t4g.small
NODE_MIN=2
NODE_MAX=4
NODE_DESIRED=2
RDS_ID=freshbox-rds
RDS_CLASS=db.t4g.small
DB_NAME=freshbox
DB_ADMIN_USER=admin
APP_DB_USER=alumno
NAMESPACE=freshbox
# Tag de la imagen del Cluster Autoscaler (vacio = el de la chart). Ej: v1.34.0
CA_IMAGE_TAG=
